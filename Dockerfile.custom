# Reuse the matching upstream runtime so the API receives its updated dependencies.
FROM ghcr.io/usekaneo/kaneo:2.48.0

ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/Zhao2018Mr/kaneo" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.version="2.48.0-custom"

USER root
# Remove previous hashed assets so only the newly built frontend is served.
RUN rm -rf /usr/share/nginx/html/*
COPY --chown=appuser:appuser apps/api/dist/index.js /app/apps/api/dist/index.js
COPY --chown=appuser:appuser apps/api/drizzle/ /app/apps/api/drizzle/
COPY --chown=appuser:appuser apps/web/dist/ /usr/share/nginx/html/
USER appuser
