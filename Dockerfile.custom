# Repackage compiled assets on the matching upstream runtime; dependencies are unchanged.
FROM ghcr.io/usekaneo/kaneo:2.46.2

ARG SOURCE_REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/Zhao2018Mr/kaneo" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.version="2.46.2-copy-config"

USER root
# Remove previous hashed assets so only the newly built frontend is served.
RUN rm -rf /usr/share/nginx/html/*
COPY --chown=appuser:appuser apps/api/dist/index.js /app/apps/api/dist/index.js
COPY --chown=appuser:appuser apps/web/dist/ /usr/share/nginx/html/
USER appuser
